{
  "name": "@linways/table-to-excel",
  "version": "2.0.0",
  "description": "Javascript library to create 'valid' excel file from html table with styles",
  "type": "module",
  "main": "./dist/tableToExcel.cjs",
  "module": "./dist/tableToExcel.js",
  "browser": "./dist/tableToExcel.js",
  "exports": {
    ".": {
      "import": "./dist/tableToExcel.js",
      "require": "./dist/tableToExcel.cjs",
      "default": "./dist/tableToExcel.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/tableToExcel.js",
    "./dist/tableToExcel.cjs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/linways/table-to-excel"
  },
  "bugs": {
    "url": "https://github.com/linways/table-to-excel/issues"
  },
  "homepage": "https://github.com/linways/table-to-excel#readme",
  "keywords": [
    "html table to excel",
    "excel with styles",
    "excel js",
    "table to excel",
    "html to xlsx"
  ],
  "scripts": {
    "build": "tsup src/tableToExcel.js --format esm,cjs --clean --sourcemap",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Rohith Bhaskaran",
  "license": "MIT",
  "devDependencies": {
    "chai": "^4.2.0",
    "eslint": "^7.32.0",
    "jsdom": "^25.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.1",
    "jszip": "^3.2.1"
  }
}
